# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_OR_ANON_KEY

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Streamlit dashboard base URL, no trailing slash (used to build "view on Stand"
# links in Telegram alerts, e.g. https://your-app.streamlit.app). Leave blank to
# omit that link.
DASHBOARD_URL=

# Residential/rotating proxy for OLX requests, format http://user:pass@host:port.
# Leave blank to run direct (fine for local/residential IPs).
PROXY_URL=

# Route OLX requests through headless Chrome (Playwright). Required on cloud IPs
# (GitHub Actions): OLX's WAF 403s plain HTTP clients from datacenter IPs but
# passes a real browser. Needs: pip install playwright && playwright install chromium
OLX_BROWSER=0

# Crawler tuning (defaults shown)
BUDGET=2000              # max purchase price (EUR)
MARKET_CEILING=15000     # crawl ads up to this price so medians aren't biased low
MIN_DISCOUNT=0.25        # alert if >=25% below market median
MIN_PROFIT=300           # minimum estimated profit (EUR)
MAX_MILEAGE=280000       # km
CATEGORY_ID=378          # OLX.pt Carros (auto-discovered if wrong)
DEEP_SWEEP=0             # 1 = full price-bucketed sweep (weekly)
URL_CHECK_BATCH_SIZE=1500    # ad urls re-checked against their live OLX page per run
URL_CHECK_LOOKBACK_DAYS=90   # only re-check ads first seen within this many days
