# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_OR_ANON_KEY

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Crawler tuning (defaults shown)
BUDGET=2000              # max purchase price (EUR)
PRICE_CEILING=6000       # crawl ads up to this price to build market comps
MIN_DISCOUNT=0.25        # alert if >=25% below market median
MIN_PROFIT=300           # minimum estimated profit (EUR)
MAX_MILEAGE=280000       # km
CATEGORY_ID=378          # OLX.pt Carros (auto-discovered if wrong)
DEEP_SWEEP=0             # 1 = full price-bucketed sweep (weekly)
